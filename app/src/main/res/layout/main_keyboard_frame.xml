<helium314.keyboard.latin.KeyboardFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical" >

    <include
        android:id="@+id/strip_container"
        layout="@layout/strip_container" />

    <!-- Floating halves mode only (see KeyboardFrameLayout): panels are below the keyboard view, handles and grips above it. -->
    <View android:id="@+id/halves_panel_left" android:visibility="gone"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <View android:id="@+id/halves_panel_right" android:visibility="gone"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <!-- To ensure that key preview popup is correctly placed when the current system locale is
         one of RTL locales, layoutDirection="ltr" is needed in the SDK version 17+. -->
    <helium314.keyboard.latin.KeyboardWrapperView
        android:id="@+id/keyboard_view_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr" >

        <helium314.keyboard.keyboard.MainKeyboardView
            android:id="@+id/keyboard_view"
            android:layoutDirection="ltr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include
            android:id="@+id/emoji_palettes_view"
            layout="@layout/emoji_palettes_view" />
        <include
            android:id="@+id/clipboard_history_view"
            layout="@layout/clipboard_history_view" />

        <ImageButton
            android:id="@+id/btn_stop_one_handed_mode"
            android:contentDescription="@string/label_stop_onehanded_mode_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageButton
            android:id="@+id/btn_switch_one_handed_mode"
            android:contentDescription="@string/label_switch_onehanded_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageButton
            android:id="@+id/btn_resize_one_handed_mode"
            android:contentDescription="@string/label_resize_onehanded_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageView
            android:id="@+id/backgroundGatheringIndicator"
            android:visibility="visible"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/btn_keyboard_key_action_normal_lxx_base"
            android:tint="#a00000"
            android:layout_gravity="top"
            />
    </helium314.keyboard.latin.KeyboardWrapperView>
    <ImageView android:id="@+id/halves_handle_left" android:visibility="gone"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:contentDescription="@string/floating_halves" android:scaleType="centerInside"
        android:src="@drawable/ic_drag_handle_h" />
    <ImageView android:id="@+id/halves_handle_right" android:visibility="gone"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:contentDescription="@string/floating_halves" android:scaleType="centerInside"
        android:src="@drawable/ic_drag_handle_h" />
    <ImageView android:id="@+id/halves_grip_left" android:visibility="gone"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:contentDescription="@string/floating_halves" android:scaleType="fitCenter"
        android:src="@drawable/ic_resize_corner" />
    <ImageView android:id="@+id/halves_grip_right" android:visibility="gone"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:contentDescription="@string/floating_halves" android:scaleType="fitCenter"
        android:src="@drawable/ic_resize_corner" />
    <ImageView android:id="@+id/halves_grip_left_inner" android:visibility="gone"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:contentDescription="@string/floating_halves" android:scaleType="fitCenter"
        android:src="@drawable/ic_resize_corner" />
    <ImageView android:id="@+id/halves_grip_right_inner" android:visibility="gone"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:contentDescription="@string/floating_halves" android:scaleType="fitCenter"
        android:src="@drawable/ic_resize_corner" />
    <!-- opacity slider for floating halves mode, shown above the left half (see KeyboardFrameLayout) -->
    <LinearLayout android:id="@+id/halves_opacity_bar" android:visibility="gone"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content">
        <ImageView android:id="@+id/halves_opacity_icon"
            android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp"
            android:contentDescription="@string/halves_opacity_slider"
            android:src="@drawable/ic_opacity" />
        <SeekBar android:id="@+id/halves_opacity_seekbar"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:max="70"
            android:contentDescription="@string/halves_opacity_slider" />
        <TextView android:id="@+id/halves_opacity_value"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minWidth="40dp" android:gravity="end" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/float_handle_container"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/resize_handle"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/config_floating_handle_height"
            android:src="@drawable/ic_arrow_horizontal"/>
        <ImageView
            android:id="@+id/drag_handle"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/config_floating_handle_height"
            android:src="@drawable/ic_drag_indicator"/>
    </LinearLayout>
</helium314.keyboard.latin.KeyboardFrameLayout>
